# BY19Code 环境变量配置文件
#
# 使用说明：
# 1. 复制此文件为 .env（去掉 .example 后缀）
# 2. 填入你的实际 API Key
# 3. 不要将包含真实 API Key 的 .env 文件提交到 Git

# ============================================================
# Claude (Anthropic)
# ============================================================
# 获取地址: https://console.anthropic.com/
# API Key 格式: sk-ant-api03-xxxxxxxxxxxxx
# 费用: 输入 $3/百万tokens，输出 $15/百万tokens
BY19CODE_CLAUDE_API_KEY=

# ============================================================
# DeepSeek
# ============================================================
# 获取地址: https://platform.deepseek.com/
# API Key 格式: sk-xxxxxxxxxxxxx
# 费用: 输入 ¥0.14/百万tokens，输出 ¥0.28/百万tokens
BY19CODE_DEEPSEEK_API_KEY=

# ============================================================
# Kimi (Moonshot AI)
# ============================================================
# 获取地址: https://platform.moonshot.cn/
# API Key 格式: sk-xxxxxxxxxxxxx
# 费用: 输入 ¥0.12/百万tokens，输出 ¥0.12/百万tokens
# 示例: BY19CODE_KIMI_API_KEY=sk-aBcDeFgHiJkLmNoPqRsTuVwXyZ1234567890
BY19CODE_KIMI_API_KEY=

# ============================================================
# 豆包 (ByteDance)
# ============================================================
# 获取地址: https://console.volcengine.com/ark
# API Key 格式: 通常是一串字母数字组合
#
# 重要提示：
#   1. 需要先在火山引擎控制台创建推理接入点
#   2. 获取 endpoint ID（格式：ep-20241227105917-xxxxxx）
#   3. 在 config.json 中修改 doubao 的 model 字段为你的 endpoint ID
#   4. 示例: "model": "ep-20241227105917-abc123"
#
# 费用: 按实际使用计费，不同模型价格不同
# 示例: BY19CODE_DOUBAO_API_KEY=abc123def456ghi789jkl012mno345pqr678
BY19CODE_DOUBAO_API_KEY=

# ============================================================
# 智谱 GLM (Zhipu AI)
# ============================================================
# 获取地址: https://open.bigmodel.cn/
# API Key 格式: xxxxxxxxxxxxx.xxxxxxxxxxxxx（包含点号）
# 费用: 输入 ¥0.05/百万tokens，输出 ¥0.05/百万tokens
# 示例: BY19CODE_GLM_API_KEY=abc123def456.ghi789jkl012mno345pqr678
BY19CODE_GLM_API_KEY=

# ============================================================
# 其他配置（可选）
# ============================================================

# 如果需要使用代理，可以设置以下环境变量
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# 日志级别（可选，默认为 INFO）
# LOG_LEVEL=DEBUG
