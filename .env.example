# BY19Code 环境变量配置示例
# 复制此文件为 .env 并填入真实的 API Key

# Claude API Key（Anthropic 官方或中转站）
BY19CODE_CLAUDE_API_KEY=

# Claude Base URL（可选，使用中转站时填写）
BY19CODE_CLAUDE_BASE_URL=https://api.anthropic.com

# DeepSeek API Key
BY19CODE_DEEPSEEK_API_KEY=

# DeepSeek Base URL（通常不需要修改）
BY19CODE_DEEPSEEK_BASE_URL=https://api.deepseek.com

# 其他 LLM Provider（可选）
# BY19CODE_OPENAI_API_KEY=
# BY19CODE_OPENAI_BASE_URL=https://api.openai.com/v1
